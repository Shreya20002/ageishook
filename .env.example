# Copy to .env and fill in. .env is gitignored -- never commit a real key.
#
# The deployer key is NOT read from here. Import it once into Foundry's encrypted
# keystore and pass --account aegis-sepolia on every command:
#
#   cast wallet import aegis-sepolia --interactive

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Filled in from the output of script/DeploySepolia.s.sol
GUARDIAN_HOOK=
TOKEN0=
TOKEN1=
