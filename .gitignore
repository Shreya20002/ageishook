# node / next
node_modules
.next
next-dev*.log

# local editor / tooling config, not part of the project
.claude/

# foundry / hardhat build output
cache
out
artifacts
coverage
typechain-types

# secrets — never commit these
.env
.env.*
!.env.example

# Foundry broadcast records.
# A Sepolia FORK reports chain id 11155111, so its run artifacts land in the same
# directory a real Sepolia deploy would use and are indistinguishable from it.
# Committing them would imply public deployments that do not exist -- use Etherscan
# links as deployment evidence instead.
broadcast/
